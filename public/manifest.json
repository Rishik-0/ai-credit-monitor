{
  "manifest_version": 3,
  "name": "AI Credit Monitor",
  "version": "0.0.1",
  "description": "A Chrome Extension scaffolded with React and Vite.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.googleapis.com/*"
  ]
}